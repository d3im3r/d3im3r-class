# Configuración opcional para Google OAuth con Better Auth
GOOGLE_CLIENT_ID=tu_cliente_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_cliente_secret
BETTER_AUTH_SECRET=aula-better-auth-secret-key-2026
BETTER_AUTH_URL=http://localhost:3101

