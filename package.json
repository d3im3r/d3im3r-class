{
  "name": "aula-latex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3101",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3101",
    "import:content": "tsx scripts/import-content.ts",
    "test": "tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" next.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" next.config.ts",
    "compile:diagrams": "python3 scripts/compile-diagrams.py",
    "build:assets": "python3 scripts/build-assets.py",
    "reset-password": "tsx --env-file=.env.local scripts/reset-password.ts",
    "content:build": "npm run import:content && npm run compile:diagrams && npm run import:content"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/pg": "^8.23.1",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.69.0",
    "next": "^16.4.5",
    "node-tikzjax": "^1.0.5",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "type": "module"
}
