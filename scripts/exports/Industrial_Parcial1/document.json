            {
              "type": "math",
              "latex": "M=\n            \\begin{bmatrix}\n                1 & 0 & 0\\\\\n                0 & 1 & 0\\\\\n                0 & 0 & -1\n            \\end{bmatrix}",
              "display": true
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "como matriz de rotación."
                }
              ]
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "¿Cuál afirmación es correcta?"
                }
              ]
            }
          ],
          "options": {
            "layout": "vertical",
            "items": [
              {
                "label": "A",
                "blocks": [
                  {
                    "type": "paragraph",
                    "children": [
                      {
                        "type": "math_inline",
                        "latex": "M\\in SO(3)"
                      },
                      {
                        "type": "text",
                        "value": ", porque "
                      },
                      {
                        "type": "math_inline",
                        "latex": "M^TM=I"
                      },
                      {
                        "type": "text",
                        "value": "."
                      }
                    ]
                  }
                ]
              },
              {
                "label": "B",
                "blocks": [
                  {
                    "type": "paragraph",
                    "children": [
                      {
                        "type": "math_inline",
                        "latex": "M\\notin SO(3)"
                      },
                      {
                        "type": "text",
                        "value": ", porque no es una matriz ortogonal."
                      }
                    ]
                  }
                ]
              },
              {
                "label": "C",
                "blocks": [
                  {
                    "type": "paragraph",
                    "children": [
                      {
                        "type": "math_inline",
                        "latex": "M\\notin SO(3)"
                      },
                      {
                        "type": "text",
                        "value": ": aunque "
                      },
                      {
                        "type": "math_inline",
                        "latex": "M^TM=I"
                      },
                      {
                        "type": "text",
                        "value": ", se cumple "
                      },
                      {
                        "type": "math_inline",
                        "latex": "\\det(M)=-1"
                      },
                      {
                        "type": "text",
                        "value": "."
                      }
                    ]
                  }
                ]
              },
              {
                "label": "D",
                "blocks": [
                  {
                    "type": "paragraph",
                    "children": [
                      {
                        "type": "math_inline",
                        "latex": "M\\in SO(3)"
                      },
                      {
                        "type": "text",
                        "value": ", porque su inversa coincide con su transpuesta."
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
