            {
              "type": "math",
              "latex": "\\mathbf{p}\n            =\n            \\begin{bmatrix}\n                0\\\\\n                1\\\\\n                0\n            \\end{bmatrix}.",
              "display": true
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "Se comparan:"
                }
              ]
            },
            {
              "type": "math",
              "latex": "\\mathbf{p}_A\n            =\n            R_z(90^\\circ)R_x(90^\\circ)\\mathbf{p}",
              "display": true
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "y:"
                }
              ]
            },
            {
              "type": "math",
              "latex": "\\mathbf{p}_B\n            =\n            R_x(90^\\circ)R_z(90^\\circ)\\mathbf{p}.",
              "display": true
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "type": "text",
                  "value": "¿Cuál resultado es correcto?"
                }
              ]
            }
          ],
          "options": {
            "layout": "vertical",
            "items": [
              {
                "label": "A",
                "blocks": [
                  {
                    "type": "math",
                    "latex": "\\mathbf{p}_A\n                    =\n                    \\mathbf{p}_B\n                    =\n                    \\begin{bmatrix}\n                        0\\\\0\\\\1\n                    \\end{bmatrix}",
                    "display": true
                  }
                ]
              },
              {
                "label": "B",
                "blocks": [
                  {
                    "type": "math",
                    "latex": "\\mathbf{p}_A\n                    =\n                    \\begin{bmatrix}\n                        0\\\\0\\\\1\n                    \\end{bmatrix},\n                    \\qquad\n                    \\mathbf{p}_B\n                    =\n                    \\begin{bmatrix}\n                        -1\\\\0\\\\0\n                    \\end{bmatrix}",
                    "display": true
                  }
                ]
              },
              {
                "label": "C",
                "blocks": [
                  {
                    "type": "math",
                    "latex": "\\mathbf{p}_A\n                    =\n                    \\begin{bmatrix}\n                        -1\\\\0\\\\0\n                    \\end{bmatrix},\n                    \\qquad\n                    \\mathbf{p}_B\n                    =\n                    \\begin{bmatrix}\n                        0\\\\0\\\\1\n                    \\end{bmatrix}",
                    "display": true
                  }
                ]
              },
              {
                "label": "D",
                "blocks": [
                  {
                    "type": "paragraph",
                    "children": [
                      {
                        "type": "text",
                        "value": "Ambos resultados tienen que ser iguales porque las matrices de rotación son ortogonales."
                      }
                    ]
                  }
                ]
              }
            ]
          }
        },
