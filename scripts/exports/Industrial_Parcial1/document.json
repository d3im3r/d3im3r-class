                "label": "A",
                "blocks": [
                  {
                    "type": "math",
                    "latex": "\\mathbf{p}'\n                    =\n                    R_x(90^\\circ)R_z(90^\\circ)\\mathbf{p}\n                    =\n                    \\begin{bmatrix}\n                        -1\\\\0\\\\0\n                    \\end{bmatrix}",
