                    "latex": "\\mathbf{p}'\n                    =\n                    R_x(90^\\circ)R_z(90^\\circ)\\mathbf{p}\n                    =\n                    \\begin{bmatrix}\n                        0\\\\0\\\\1\n                    \\end{bmatrix}",
                    "display": true
                  }
