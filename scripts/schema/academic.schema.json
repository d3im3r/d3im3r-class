{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d3im3r-class.local/schema/academic-1.1.0.json",
  "title": "d3im3r-class Academic Document (lesson, guide, exam)",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "type",
    "title",
    "metadata",
    "source",
    "structure"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "lesson",
        "guide",
        "exam"
      ]
    },
    "title": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "file",
        "template"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "template": {
          "enum": [
            "beamer",
            "guide",
            "exam"
          ]
        }
      },
      "additionalProperties": false
    },
    "structure": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "instructions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "answerSheet": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "$defs": {
    "section": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "section",
            "subsection",
            "subsubsection"
          ]
        },
        "title": {
          "type": "string"
        },
        "starred": {
          "type": "boolean"
        },
        "implicit": {
          "type": "boolean"
        },
        "introTitle": {
          "type": "string"
        },
        "introSubtitle": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/section"
              },
              {
                "$ref": "#/$defs/frame"
              },
              {
                "$ref": "#/$defs/question"
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "frame"
        },
        "title": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "sourceLine": {
          "type": "integer",
          "minimum": 1
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      },
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "type",
        "number",
        "points",
        "stem",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "question"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "points": {
          "type": [
            "integer",
            "number",
            "null"
          ],
          "minimum": 0
        },
        "stem": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "options": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "layout",
                "items"
              ],
              "properties": {
                "layout": {
                  "enum": [
                    "inline",
                    "vertical",
                    "grid"
                  ]
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "label",
                      "blocks"
                    ],
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "blocks": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/block"
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "inline": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "latex"
          ],
          "properties": {
            "type": {
              "const": "math_inline"
            },
            "latex": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "line_break"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "children"
          ],
          "properties": {
            "type": {
              "enum": [
                "strong",
                "emphasis",
                "underline",
                "code_inline",
                "small_caps",
                "span"
              ]
            },
            "href": {
              "type": [
                "string",
                "null"
              ]
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "href",
            "children"
          ],
          "properties": {
            "type": {
              "const": "link"
            },
            "href": {
              "type": "string"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "children"
          ],
          "properties": {
            "type": {
              "const": "paragraph"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/inline"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "latex",
            "display"
          ],
          "properties": {
            "type": {
              "const": "math"
            },
            "latex": {
              "type": "string"
            },
            "display": {
              "const": true
            },
            "label": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "variant",
            "children"
          ],
          "properties": {
            "type": {
              "const": "academic_block"
            },
            "variant": {
              "type": "string"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/block"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "assetId"
          ],
          "properties": {
            "type": {
              "const": "figure"
            },
            "assetId": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "language",
            "value"
          ],
          "properties": {
            "type": {
              "const": "code"
            },
            "language": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "fileName": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "variant",
            "items"
          ],
          "properties": {
            "type": {
              "const": "list"
            },
            "variant": {
              "enum": [
                "itemize",
                "enumerate",
                "description",
                "checklist"
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "blocks"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "checked": {
                    "type": "boolean"
                  },
                  "blocks": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/block"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "rows"
          ],
          "properties": {
            "type": {
              "const": "table"
            },
            "columnSpec": {
              "type": [
                "string",
                "null"
              ]
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "colspan",
                    "rowspan",
                    "children"
                  ],
                  "properties": {
                    "colspan": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "rowspan": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "children": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/block"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "reason",
            "latex"
          ],
          "properties": {
            "type": {
              "const": "unsupported"
            },
            "reason": {
              "type": "string"
            },
            "env": {
              "type": "string"
            },
            "latex": {
              "type": "string"
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/block"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}